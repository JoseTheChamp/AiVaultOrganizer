{
  "name": "ai-vault-organizer",
  "version": "0.0.1",
  "description": "Organize your Obsidian vault with a written charter: diagnose, plan, review, apply with backup and undo, and keep notes aligned over time.",
  "private": true,
  "type": "module",
  "main": "main.js",
  "license": "MIT",
  "author": "Josef Knotek",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoseTheChamp/AiVaultOrganizer.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "dev:vault": "npm run build && node scripts/dev-vault.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test",
    "analyze": "tsx eval/cli.ts analyze",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "nano-staged": "^1.0.2",
    "obsidian": "^1.13.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "nano-staged": {
    "*.{ts,mts,mjs}": "eslint --max-warnings=0",
    "package.json": "eslint --max-warnings=0"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  }
}
