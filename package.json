{
  "name": "ai-vault-organizer",
  "version": "0.0.1",
  "description": "Organize your Obsidian vault with a written charter: diagnose, plan, review, apply with backup and undo, and keep notes aligned over time.",
  "private": true,
  "type": "module",
  "main": "main.js",
  "license": "MIT",
  "author": "Josef Knotek",
  "repository": {
    "type": "git",
    "url": "https://github.com/JoseTheChamp/AiVaultOrganizer.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "obsidian": "^1.13.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
